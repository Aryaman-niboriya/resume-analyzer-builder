# Backend API (Render/Railway URL in production, e.g. https://your-api.onrender.com)
VITE_API_URL=http://localhost:5001

# Google OAuth (same client ID as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional n8n webhook for HR Mode
VITE_N8N_WEBHOOK_URL=
